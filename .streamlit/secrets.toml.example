# =============================================================
#  .streamlit/secrets.toml 템플릿
# =============================================================
#  사용법:
#  1) 이 파일을 .streamlit/secrets.toml 로 복사
#  2) 아래 값들을 채우기
#  3) 배포 시: Streamlit Cloud 대시보드 > App settings > Secrets에 같은 내용 붙여넣기
# =============================================================

# ----- 비밀번호 (필수 권장) -----
# 본인만 접속하려면 반드시 설정. 비워두면 누구나 접속 가능.
APP_PASSWORD = "여기에-원하는-비밀번호"

# ----- Claude API (선택) -----
# AI 문서 검토/요약 기능을 쓰려면 필요. console.anthropic.com에서 발급.
ANTHROPIC_API_KEY = "sk-ant-..."

# ----- GitHub (Streamlit Cloud 배포 시 필수) -----
# 로컬에서 테스트만 할 거면 아래 4개는 비워두세요 — 비어 있으면 로컬 폴더 모드로 자동 전환.
#
# GITHUB_TOKEN: Personal Access Token (classic 또는 fine-grained). repo 권한 필요.
#   https://github.com/settings/tokens
# GITHUB_REPO: "사용자명/저장소이름" 형태
# GITHUB_BRANCH: 작업할 브랜치 (보통 main)
# GITHUB_DOCS_PREFIX: repo 안에서 .md들이 들어있는 하위 폴더 (없으면 빈 문자열)
GITHUB_TOKEN = ""
GITHUB_REPO = ""
GITHUB_BRANCH = "main"
GITHUB_DOCS_PREFIX = ""

# ----- 로컬 모드일 때 기본 폴더 (선택) -----
LOCAL_DOCS_PATH = "C:\\Users\\user\\Desktop\\챗봇"
