# =============================================================
#  ⚠️  주의 — 이 파일(.example)은 "예시 템플릿"입니다.
#
#  실제 설정은 이 파일이 아니라  secrets.toml  에 하세요!
#  이 .example 파일은 GitHub에 공개되므로, 여기에 실제
#  토큰·비밀번호를 넣으면 외부에 노출됩니다. 절대 넣지 마세요.
# =============================================================
#
#  실제 사용법:
#   - 같은 폴더의 secrets.toml 파일에 아래 형식으로 값을 채웁니다.
#   - Streamlit Cloud 배포 시엔 대시보드 > Settings > Secrets 에 붙여넣습니다.

# ----- 비밀번호 (선택) -----
# 설정하면 앱 접속 시 비밀번호를 요구. 로컬 전용이면 생략 가능.
APP_PASSWORD = ""

# ----- Claude API (선택) -----
# AI 문서 검토/요약 기능용. console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY = ""

# ----- GitHub (GitHub의 문서를 쓸 때 필수) -----
# GITHUB_TOKEN: Personal Access Token (fine-grained, Contents 권한)
# GITHUB_REPO: "사용자명/저장소이름" 형태
# GITHUB_BRANCH: 작업할 브랜치 (보통 main)
# GITHUB_DOCS_PREFIX: repo 안에서 .md 들이 든 하위 폴더 (없으면 빈 문자열)
GITHUB_TOKEN = ""
GITHUB_REPO = ""
GITHUB_BRANCH = "main"
GITHUB_DOCS_PREFIX = ""

# ----- 로컬 폴더 모드용 (선택) -----
# GitHub 설정이 비어 있으면 이 폴더를 직접 사용.
LOCAL_DOCS_PATH = ""
